# Copy to .env (or run ./setup.sh, which does it and fills in the secrets).
# Never commit .env: it holds the keys that encrypt your bank credentials.

# Required: generated by ./setup.sh
SECRET_KEY_BASE=
POSTGRES_PASSWORD=

# Port the app listens on, on the Proxmox VM/LXC
PORT=3000

# "open" until you've created your account, then "closed"
ONBOARDING_STATE=open

# Set when you put the app behind HTTPS (reverse proxy or Tailscale Serve)
# APP_DOMAIN=finance.example.com
# RAILS_FORCE_SSL=true
# RAILS_ASSUME_SSL=true

# Image to run. Leave as-is until the fork has its own features.
# SURE_IMAGE=ghcr.io/jeremy8215/sure
# SURE_IMAGE_TAG=latest

# Database backups
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# Optional AI features
# OPENAI_ACCESS_TOKEN=
# OPENAI_MODEL=
# OPENAI_URI_BASE=
